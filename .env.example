NODE_ENV=production
PORT=3000
# Required in production — must be https (CORS only allows this origin)
APP_URL=https://your-domain.com
SESSION_SECRET=change-me-to-a-long-random-string
# Secure cookies + HSTS when APP_URL is https (or force with COOKIE_SECURE=1)
# COOKIE_SECURE=1
# Emergency only: allow http APP_URL in production
# ALLOW_INSECURE_APP_URL=1
# Optional: force cookie Domain (default: derive .apex from APP_URL so www + apex share session)
# COOKIE_DOMAIN=.your-domain.com
# CSP: enforced in production; set CSP_REPORT_ONLY=1 to observe without blocking
# CSP_REPORT_ONLY=1
# Captcha: required in production (Turnstile keys in platform settings); CAPTCHA_OPTIONAL=1 to skip
# CAPTCHA_OPTIONAL=1
# MCP JSON-RPC batch size cap (default 25, max 100)
# MCP_BATCH_MAX=25
# Extra OAuth redirect URIs for MCP (comma-separated). Always allows
# https://claude.ai/api/mcp/auth_callback and Claude Code loopback /callback.
# MCP_OAUTH_REDIRECT_URIS=
# After first boot, remove BOOTSTRAP_EMAIL / BOOTSTRAP_PASSWORD from the server env

# mysql (Hostinger / Docker) or sqlite (local without Docker)
DB_DRIVER=mysql

# Local-only SQLite file when DB_DRIVER=sqlite
# SQLITE_PATH=./data/website-scout-web.sqlite

# Hostinger MySQL (or local Docker) when DB_DRIVER=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=scout
MYSQL_PASSWORD=scout
MYSQL_DATABASE=website_scout

# Optional: create first owner on migrate if no users exist
# BOOTSTRAP_EMAIL=owner@example.com
# BOOTSTRAP_PASSWORD=change-me
# BOOTSTRAP_WORKSPACE=My Workspace
# Opt-in: promote bootstrap user to platform super admin (default off)
# BOOTSTRAP_SUPER_ADMIN=1
# Site/export files (must match docker-compose volume mount)
# EXPORT_ROOT=/var/lib/website-scout-exports

# Stripe (optional — can also set in Admin → Stripe)
# Prefer a restricted API key (rk_…) over a full secret key when possible
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...

# Encryption at rest for secret settings (ai.api_key, smtp.pass,
# cf.api_token, ...). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Existing plaintext secrets are migrated lazily on boot / workspace
# open. If this key is lost, stored secrets cannot be recovered and
# must be re-entered in Settings. Strongly recommended in production;
# without it secrets are stored as plaintext.
# SETTINGS_ENCRYPTION_KEY=
